# 凭据 —— 任何情况下都不进仓库
.env
*.env
credentials.env
!*.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Node
node_modules/
.vite/

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 构建产物与压缩包
*.zip
*.7z
build/
/dist/

# frontend/dist 必须进仓库：评审者不装 node_modules 也应能直接跑起前端。
# 注意不能写 `frontend/dist/`——目录一旦被排除，后面的 ! 取反对它无效。
# 这里用根锚定的 `/dist/`，只排除仓库根目录下的构建产物。
